# Copy to .env and fill in. Get the host from Supabase > Connect > Session pooler.
# Username is club_reader.<project-ref> (the read-only role from readonly_role.sql).
DATABASE_URL=postgresql+psycopg://club_reader.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require
