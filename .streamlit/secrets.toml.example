# Copy to .streamlit/secrets.toml for local runs.
# On Streamlit Community Cloud, paste this into the app's Settings > Secrets instead.

# Game entry (optional). Without this and [connections.writer], the "Enter a game" tab stays locked.
# Must stay ABOVE the [connections...] sections, or TOML files it under them.
admin_password = "YOUR_ADMIN_PAGE_PASSWORD"

# Read-only login used for everything the dashboard displays.
[connections.sql]
url = "postgresql+psycopg://club_reader.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Game entry login: can only call record_game() and add_player() (see insert_tables.sql).
[connections.writer]
url = "postgresql+psycopg://club_writer.YOUR_PROJECT_REF:YOUR_WRITER_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require"
